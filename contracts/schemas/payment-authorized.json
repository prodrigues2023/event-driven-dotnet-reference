{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodrigues2023.github.io/event-driven-dotnet-reference/schemas/payment-authorized.json",
  "title": "PaymentAuthorized",
  "description": "A payment was authorized for an order. Published by Payments to payments.events with routing key payment.authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "paymentId", "amount"],
  "properties": {
    "orderId": { "type": "string", "format": "uuid" },
    "paymentId": { "type": "string", "format": "uuid" },
    "amount": { "type": "number" }
  },
  "examples": [
    { "orderId": "8be22800-615b-4cda-b787-1d7bb4a669b9", "paymentId": "2ba9fbb8-1eaf-43e7-a6c6-ac495a129255", "amount": 250.00 }
  ]
}
